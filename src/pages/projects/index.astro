
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/layout/Navbar.astro";
import Footer from "../../components/layout/Footer.astro";
---

<BaseLayout
  title="Projects | Maditron"
  description="Projects and experiments by Mahdi Namehavar."
>
  <Navbar />

  <main>
    <section class="section projects-hero">
      <div class="container">
        <div class="kicker">PORTFOLIO / 01</div>
        <h1>Projects</h1>
        <p class="projects-intro">
          Things I've built and worked on.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="projects-grid">

          <a
            href="/projects/customer-support-automation/"
            class="project-card"
          >
            <div class="kicker">01 / AI & AUTOMATION</div>

            <h2>Customer Support Operations Automation</h2>

            <p>
              An automation project exploring how AI and workflow automation
              can improve customer support operations.
            </p>

            <div class="resume-skills">
              <span>n8n</span>
              <span>Ollama</span>
              <span>AI</span>
              <span>Automation</span>
            </div>

            <span class="project-card-link">View Project ↗</span>
          </a>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
